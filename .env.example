# Variaveis de ambiente do Estoque TI WAP.
# Copie este arquivo para .env.local e preencha com os valores do projeto Supabase
# de DESENVOLVIMENTO (o projeto de ensaio). O .gitignore ignora .env* (exceto este
# .env.example); nunca commitar .env.local nem chave real.
#
# F55 (10/09/2026) — este arquivo cobre TODO `process.env.X` lido por src/ e por
# scripts/ (fora de arquivo de teste). `scripts/env-exemplo.test.ts` varre os dois
# diretorios e reprova quando uma variavel nova nasce sem entrar aqui OU na lista
# nominal de SISTEMA descrita no proprio teste. Nenhuma linha abaixo tem valor:
# isto e o VOCABULARIO das variaveis, nunca o segredo.

# =============================================================================
# APLICACAO — o que a Vercel precisa para rodar o sistema
# =============================================================================

# Projeto Supabase (dev) — URL e chave publicavel/anon. Podem ir para o client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server/scripts apenas — nunca NEXT_PUBLIC.
# So em codigo server-side ou scripts locais; jamais em Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Acesso por senha aos relatorios (F3, spec §3). Segredo que assina (HMAC) o
# cookie httpOnly da sessao de VISUALIZACAO por senha. Gere um valor forte e
# unico por ambiente (nunca reutilizar dev/prod):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# So server-side; jamais NEXT_PUBLIC. Trocar este valor invalida todas as
# sessoes de visualizacao ativas.
VIEW_SESSION_SECRET=

# =============================================================================
# DADOS FICTICIOS — as guardas de db:seed / db:reset (scripts/env-guard.ts)
# =============================================================================
# Precaucao anti-acidente, em DUAS camadas desde a F55: o ref do projeto tem de
# estar na lista de PERMISSAO (REFS_DE_ENSAIO, em scripts/env-guard.ts) e o
# PROPRIO BANCO confirma que e o ensaio (public.rotulo_de_ambiente()). Nunca
# aponte para producao.

# 1) Confirmacao explicita da execucao (precisa ser exatamente: sim):
SEED_CONFIRM=
# 2) Ref do projeto Supabase de ENSAIO (o subdominio da NEXT_PUBLIC_SUPABASE_URL:
#    https://<ref>.supabase.co). O script recusa se o ref nao estiver na lista
#    de ensaio permitida.
SEED_PROJECT_REF=

# =============================================================================
# FERRAMENTA — scripts locais (e o workflow agendado), fora do bundle da Vercel
# =============================================================================
# Cada bloco pertence a UM script (ou familia de scripts); nenhuma destas chega
# ao app em producao. Uso detalhado: ver o cabecalho do proprio script.

# --- scripts/smoke/*.mjs (smoke test — local e o workflow agendado saude.yml) ---
SMOKE_ALVO=
SMOKE_EMAIL=
SMOKE_SENHA=
SMOKE_SUPABASE_URL=
SMOKE_SUPABASE_ANON_KEY=
SMOKE_URL_APP=
SMOKE_VERSAO_ESPERADA=

# --- scripts/perf/medir.mjs (harness de TTFB das rotas, F33) ---
PERF_AQUECIMENTO=
PERF_EMAIL=
PERF_REPETICOES=
PERF_ROTULO=
PERF_SAIDA=
PERF_SENHA=
PERF_SUPABASE_ANON_KEY=
PERF_SUPABASE_URL=
PERF_TIMEOUT_MS=
PERF_URL_APP=

# --- scripts/perf/medir-itens.mjs (harness de saldo/diario de itens, F37 · D6) ---
MEDIR_ITENS_ACCESS_TOKEN=
MEDIR_ITENS_CONFIRM=
MEDIR_ITENS_DESLIGAR_TRIGGER=
MEDIR_ITENS_FRACAO_QUENTE=
MEDIR_ITENS_ITENS_FICTICIOS=
MEDIR_ITENS_LOTE=
MEDIR_ITENS_PATAMARES=
MEDIR_ITENS_REF=
MEDIR_ITENS_REPETICOES_INSERT=
MEDIR_ITENS_REPETICOES_LEITURA=
MEDIR_ITENS_ROTULO=
MEDIR_ITENS_SAIDA=
MEDIR_ITENS_TIMEOUT_MS=

# --- scripts/import/ (carga UNICA do go-live — ferramenta, nao feature do app) ---
# Vai a ENSAIO OU a PRODUCAO por desenho (ver o comentario em
# scripts/import/guard.ts): esta guarda NAO tem lista de ref permitida — so a
# CONSISTENCIA entre CARGA_PROJECT_REF e a URL em uso, mais a confirmacao
# explicita (CARGA_CONFIRM=sim).
CARGA_ADMIN_EMAIL=
CARGA_CONFIRM=
CARGA_PROJECT_REF=
CARGA_SERVICE_ROLE_KEY=
CARGA_SUPABASE_URL=

# --- banco: roteiros locais, restauracao de backup, geracao/diff de tipos ---
# Roteiros SQL locais (npm run db:test) e scripts/db/restaurar.mjs.
DATABASE_URL=
# Ref do projeto usado por npm run db:types (scripts/gen-types.ts).
DB_TYPES_PROJECT_REF=
# Token da CLI (npx supabase login), usado por scripts que chamam a Management
# API (db:types, migrations por API). NUNCA fica no .env.local depois de
# logado — mora no cofre de credenciais do sistema operacional (Frente F).
SUPABASE_ACCESS_TOKEN=

# =============================================================================
# SISTEMA — NAO se declaram aqui
# =============================================================================
# NODE_ENV, VERCEL_* (VERCEL_ENV / VERCEL_GIT_COMMIT_REF / _SHA / _MESSAGE), HOME,
# LOCALAPPDATA, VITEST, CI e GITHUB_STEP_SUMMARY sao definidas pelo AMBIENTE
# (runtime do Next, deploy da Vercel, sistema operacional, runner do Vitest ou
# do GitHub Actions) — nunca pelo operador deste projeto, e por isso nao entram
# neste arquivo. A lista completa, com o motivo de cada uma escrito, vive em
# scripts/env-exemplo.test.ts.

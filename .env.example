# Variaveis de ambiente do Estoque TI WAP.
# Copie este arquivo para .env.local e preencha com os valores do projeto
# Supabase de DESENVOLVIMENTO. O .gitignore ignora .env* (exceto este .env.example);
# nunca commitar .env.local nem chaves reais.

# Projeto Supabase (dev) — URL e chave publicavel/anon. Podem ir para o client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server/scripts apenas — nunca NEXT_PUBLIC.
# So em codigo server-side ou scripts locais; jamais em Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Guardas dos scripts de dados ficticios (db:seed / db:reset) ----
# Precaucao anti-acidente: os scripts SO rodam se as duas variaveis abaixo
# baterem. Nunca aponte para producao.
# 1) Confirmacao explicita da execucao (precisa ser exatamente: sim):
SEED_CONFIRM=
# 2) Ref do projeto Supabase de DEV (o subdominio da NEXT_PUBLIC_SUPABASE_URL:
#    https://<ref>.supabase.co). O script recusa se o ref da URL for diferente.
SEED_PROJECT_REF=

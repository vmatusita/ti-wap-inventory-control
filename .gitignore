# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Arquivos de bloqueio do Office (`~$responsabilidade-notebook.docx` e irmãos).
# O Word cria um ao ABRIR qualquer .docx e nem sempre o apaga — um ficou solto em
# src/templates/termos/ e entraria num `git add .` (revisão de 31/08/2026). Os 7
# modelos de termo se editam por script (scripts/termos/, F25/F39), nunca pelo
# Word; abrir para CONFERIR é legítimo, e o lixo que isso deixa para aqui.
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI (artefatos locais)
/supabase/.temp
/supabase/.branches

# Claude Code (worktrees, launch.json, artefatos internos)
.claude/

# F4 — relatórios da carga única (contêm dados reais; nunca commitar)
carga-*.csv
carga-*.json

# scratchpad de sessão (SQL avulso, rascunhos) — nunca versionar
/scratchpad/

# Arquivos de trabalho que scripts de prova criam na raiz e apagam no fim (F55).
zz-*
